# Copy to backend/.env for local development.
# NEVER commit a real .env — the Neon connection string and Cloudinary
# secret belong only in the Render Web Service's environment variables.

PORT=3000
NODE_ENV=development

# Neon PostgreSQL connection string. Backend only. Never in the frontend.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/overberg?sslmode=require

# Admin dashboard
ADMIN_PASSWORD=change_this_to_something_long
ADMIN_JWT_SECRET=replace_with_a_long_random_string

# Comma-separated origins allowed to call this API from a browser.
# Set to the static site's URL(s) in production. Never a wildcard.
STATIC_SITE_ORIGINS=http://localhost:8080

# Cloudinary — image hosting/CDN. Backend only. Never in the frontend.
# Get these from https://console.cloudinary.com (Dashboard / Getting Started).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Render Deploy Hook for the static site. Lets the admin "Website" tab
# trigger a rebuild (refreshes the products/gallery/settings JSON snapshot
# the public site is served from). Not needed for local development.
# Get it from Render dashboard -> Static Site -> Settings -> Deploy Hook.
RENDER_STATIC_DEPLOY_HOOK=
